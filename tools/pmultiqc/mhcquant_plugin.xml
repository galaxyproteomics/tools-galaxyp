<macros>
    <!-- The mhcquant module matches on the file names (multiqc_*.txt, percolator_plot.txt)
         produced by the nf-core/mhcquant pmultiqc step -->
    <token name="@MHCQUANT_COMMAND@"><![CDATA[
        #set $pattern = ""
        #set $prefix = ""
        #set $suffix = ""
        @LN_FILES@
    ]]></token>
    <xml name="mhcquant_form">
        <param name="input" type="data" format="tabular,txt" multiple="true" label="mhcquant pmultiqc output files" help="Files from the nf-core/mhcquant results folder: multiqc_general_stats.txt, multiqc_chromatogram.txt, multiqc_histogram_*.txt, multiqc_length_dist.txt, multiqc_mass_error.txt, multiqc_peptide_intensity.txt, multiqc_scores_xcorr.txt and percolator_plot.txt"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="mhcquant_test">
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="mhcquant"/>
                <param name="input" value="mhcquant/multiqc_general_stats.txt,mhcquant/multiqc_chromatogram.txt,mhcquant/multiqc_histogram_mz.txt,mhcquant/multiqc_histogram_rt.txt,mhcquant/multiqc_histogram_im.txt,mhcquant/multiqc_histogram_scores.txt,mhcquant/multiqc_length_dist.txt,mhcquant/multiqc_mass_error.txt,mhcquant/multiqc_peptide_intensity.txt,mhcquant/multiqc_scores_xcorr.txt,mhcquant/percolator_plot.txt"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="mhcquant"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="JY_A"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
