<macros>
    <!-- FragPipe report files have no shared content marker, the module matches on the file names -->
    <token name="@FRAGPIPE_COMMAND@"><![CDATA[
        #set $pattern = ""
        #set $prefix = ""
        #set $suffix = ""
        @LN_FILES@
    ]]></token>
    <xml name="fragpipe_form">
        <param name="input" type="data" format="tabular" multiple="true" label="FragPipe report files" help="psm.tsv and ion.tsv (or combined_ion.tsv, combined_peptide.tsv, combined_protein.tsv)"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="fragpipe_test">
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="fragpipe"/>
                <param name="input" value="fragpipe/psm.tsv,fragpipe/ion.tsv"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="FragPipe"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="33075_multiplexed_fraction_1"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
