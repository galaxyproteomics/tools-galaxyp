<macros>
    <token name="@MZIDENTML_COMMAND@"><![CDATA[
        ## mzIdentML documents contain the root element name 'mzIdentML'
        #set $pattern = "mzIdentML"
        #set $prefix = ""
        #set $suffix = ""
        @LN_FILES@
        ## Optional corresponding spectra files (mzML or MGF)
        #set $pattern = ""
        #set file_paths = []
        #if str($software_cond.spectra) != "None":
            #set $at_least_one_input="T"
            #for $file in $software_cond.spectra:
                @ESCAPE_IDENTIFIER@
                #set file_path = os.path.join($software_dir, $prefix + str($identifier) + $suffix)
                @CHECK_LN_FILE@
            #end for
        #end if
    ]]></token>
    <xml name="mzidentml_form">
        <param name="input" type="data" format="mzid" multiple="true" label="mzIdentML file(s)"/>
        <param name="spectra" type="data" format="mzml,mgf" multiple="true" optional="true" label="Corresponding spectra files" help="Optional mzML or MGF files matching the mzIdentML identifications"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="mzidentml_test">
        <!-- The spectra input uses MGF: pmultiqc's mzIdentML module crashes with mzML spectra
             that contain no MS1 scans (empty-MS1 branch of get_ms_qc_info returns 4 values while
             the caller unpacks 5) and without any spectra file (draw_peaks_per_ms2 on a None
             plot object). Both bugs are present upstream, also in the main branch. -->
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="mzidentml"/>
                <param name="input" value="mzidentml/201208-378803.mzid"/>
                <param name="spectra" value="mzidentml/201208-378803.mgf" ftype="mgf"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Identification Summary"/>
                    <has_text text="Pipeline Result Statistics"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="201208-378803"/>
                    <has_text text="peptide_num"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
