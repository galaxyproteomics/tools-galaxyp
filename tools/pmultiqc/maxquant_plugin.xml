<macros>
    <!-- MaxQuant output files have no shared content marker, the module matches on the file names -->
    <token name="@MAXQUANT_COMMAND@"><![CDATA[
        #set $pattern = ""
        #set $prefix = ""
        #set $suffix = ""
        @LN_FILES@
    ]]></token>
    <xml name="maxquant_form">
        <param name="input" type="data" format="tabular" multiple="true" label="MaxQuant output files" help="parameters.txt, proteinGroups.txt, summary.txt, evidence.txt, msms.txt and/or msmsScans.txt"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="maxquant_test">
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="maxquant"/>
                <param name="input" value="maxquant/parameters.txt,maxquant/proteinGroups.txt,maxquant/summary.txt,maxquant/evidence.txt,maxquant/msms.txt,maxquant/msmsScans.txt"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="MaxQuant"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="BSA_min_21"/>
                    <has_text text="msms_identified"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
