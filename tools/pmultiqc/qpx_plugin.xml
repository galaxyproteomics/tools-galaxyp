<macros>
    <!-- QPX parquet files have no shared content marker, the module matches on the file suffixes -->
    <token name="@QPX_COMMAND@"><![CDATA[
        #set $pattern = ""
        #set $prefix = ""
        #set $suffix = ""
        @LN_FILES@
    ]]></token>
    <xml name="qpx_form">
        <param name="input" type="data" format="parquet" multiple="true" label="QPX parquet files" help="*.psm.parquet, *.pg.parquet, *.feature.parquet, *.run.parquet and/or *.sample.parquet"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="qpx_test">
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="qpx"/>
                <param name="input" value="qpx/test.psm.parquet,qpx/test.pg.parquet,qpx/test.feature.parquet,qpx/test.run.parquet,qpx/test.sample.parquet"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="QPX"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="Phospho_redissolve_final_01"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
