<macros>
    <!-- QPX parquet files have no shared content marker; the module matches them by two-part
         name suffixes ('*.psm.parquet', ...) where a dedup suffix cannot be inserted, so the
         files are staged as 1.<type>.parquet, 2.<type>.parquet, ... (the report derives run
         names from the parquet contents, not from the staged file names) -->
    <token name="@QPX_COMMAND@"><![CDATA[
        #set $mod_name = "qpx"
        #set $ln_check = ""
        #set $ln_pattern = ""
        #set $ln_param = "psm"
        #set $ln_target = "psm.parquet"
        @LN_NUMBERED@
        #set $ln_param = "pg"
        #set $ln_target = "pg.parquet"
        @LN_NUMBERED@
        #set $ln_param = "feature"
        #set $ln_target = "feature.parquet"
        @LN_NUMBERED@
        #set $ln_param = "run"
        #set $ln_target = "run.parquet"
        @LN_NUMBERED@
        #set $ln_param = "sample"
        #set $ln_target = "sample.parquet"
        @LN_NUMBERED@
    ]]></token>
    <xml name="qpx_form">
        <param name="psm" type="data" format="parquet" multiple="true" optional="true" label="psm.parquet files" help="PSM-level tables ('*.psm.parquet')"/>
        <param name="pg" type="data" format="parquet" multiple="true" optional="true" label="pg.parquet files" help="Protein group tables ('*.pg.parquet')"/>
        <param name="feature" type="data" format="parquet" multiple="true" optional="true" label="feature.parquet files" help="Feature-level tables ('*.feature.parquet')"/>
        <param name="run" type="data" format="parquet" multiple="true" optional="true" label="run.parquet files" help="Run-level tables ('*.run.parquet')"/>
        <param name="sample" type="data" format="parquet" multiple="true" optional="true" label="sample.parquet files" help="Sample-level tables ('*.sample.parquet')"/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <xml name="qpx_test">
        <test expect_num_outputs="2">
            <conditional name="software_cond">
                <param name="software" value="qpx"/>
                <param name="psm" value="qpx/test.psm.parquet"/>
                <param name="pg" value="qpx/test.pg.parquet"/>
                <param name="feature" value="qpx/test.feature.parquet"/>
                <param name="run" value="qpx/test.run.parquet"/>
                <param name="sample" value="qpx/test.sample.parquet"/>
            </conditional>
            <output name="html_report">
                <assert_contents>
                    <has_text text="QPX"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="Phospho_redissolve_final_01"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
