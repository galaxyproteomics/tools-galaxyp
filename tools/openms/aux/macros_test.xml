<macros>
<!-- a copy of a FileConverter test without the advanced options used
     in order to check if this works (all other tests enable advanced) -->
<xml name="manutest_FileConverter">
<test expect_num_outputs="1">
  <param name="in" value="FileConverter_1_input.mzData"/>
  <output name="out" file="FileConverter_1_output.mzML" compare="sim_size" delta="5700" ftype="mzml"/>
  <param name="out_type" value="mzML"/>
</test>
  <test expect_num_outputs="1">
    <section name="adv_opts">
      <param name="UID_postprocessing" value="ensure"/>
      <param name="TIC_DTA2D" value="false"/>
      <param name="MGF_compact" value="false"/>
      <param name="force_MaxQuant_compatibility" value="false"/>
      <param name="force_TPP_compatibility" value="false"/>
      <param name="convert_to_chromatograms" value="false"/>
      <param name="write_scan_index" value="true"/>
      <param name="lossy_compression" value="false"/>
      <param name="zstd_compression" value="false"/>
      <param name="lossy_mass_accuracy" value="-1.0"/>
      <param name="process_lowmemory" value="false"/>
      <param name="force" value="false"/>
      <param name="test" value="true"/>
    </section>
    <param name="in" value="FileConverter_20_input.featureXML"/>
    <param name="out_type" value="featureXML"/>
    <section name="RawToMzML">
      <param name="no_peak_picking" value="false"/>
      <param name="no_zlib_compression" value="false"/>
      <param name="include_noise" value="false"/>
      <param name="reader" value="external"/>
    </section>
    <section name="OpenSwathWorkflow">
      <param name="legacy_traml_id" value="false"/>
    </section>
    <param name="OPTIONAL_OUTPUTS" value="out_featureparquet_FLAG"/>
    <output_collection name="out_featureparquet" type="list" min="5" max="5">
      <element name="features.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="protein_groups.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="proteins.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="psms.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="search_params.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
    </output_collection>
  </test>
  <test expect_num_outputs="1">
    <section name="adv_opts">
      <param name="UID_postprocessing" value="ensure"/>
      <param name="TIC_DTA2D" value="false"/>
      <param name="MGF_compact" value="false"/>
      <param name="force_MaxQuant_compatibility" value="false"/>
      <param name="force_TPP_compatibility" value="false"/>
      <param name="convert_to_chromatograms" value="false"/>
      <param name="write_scan_index" value="true"/>
      <param name="lossy_compression" value="false"/>
      <param name="zstd_compression" value="false"/>
      <param name="lossy_mass_accuracy" value="-1.0"/>
      <param name="process_lowmemory" value="false"/>
      <param name="force" value="false"/>
      <param name="test" value="true"/>
    </section>
    <param name="in" value="FileConverter_7_input.consensusXML"/>
    <param name="out_type" value="featureXML"/>
    <section name="RawToMzML">
      <param name="no_peak_picking" value="false"/>
      <param name="no_zlib_compression" value="false"/>
      <param name="include_noise" value="false"/>
      <param name="reader" value="external"/>
    </section>
    <section name="OpenSwathWorkflow">
      <param name="legacy_traml_id" value="false"/>
    </section>
    <param name="OPTIONAL_OUTPUTS" value="out_consensusparquet_FLAG"/>
    <output_collection name="out_consensusparquet" type="list" min="5" max="5">
      <element name="consensus_features.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="protein_groups.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="proteins.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="psms.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
      <element name="search_params.parquet" ftype="parquet"><assert_contents><has_size min="100"/></assert_contents></element>
    </output_collection>
  </test>
</xml>
