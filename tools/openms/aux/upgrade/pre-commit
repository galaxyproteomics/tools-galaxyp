#!/usr/bin/env bash
# Optional git hook. Install with:
#   cp tools/openms/aux/upgrade/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# It blocks the two ways an upgrade loop silently loses work:
#  * a hand edit in a generated wrapper (reverted by the next generator run)
#  * debug leftovers / environment leaks in generated files
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# only bother when a wrapper or the generator inputs are staged
if ! git diff --cached --name-only | grep -qE '^(tools/openms/[^/]+\.xml|tools/openms/aux/|tools/openms/test-data\.sh)'; then
    exit 0
fi

if ! bash tools/openms/aux/upgrade/check_generated.sh; then
    echo "pre-commit: generated-wrapper checks failed (fix the generator input, not the XML)" >&2
    exit 1
fi
