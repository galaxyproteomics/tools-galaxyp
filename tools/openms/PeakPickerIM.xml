        <param name="processOption" value="inmemory"/>
        <param name="method" value="mobilogram"/>
        <param name="force" value="false"/>
        <param name="test" value="true"/>
      </section>
      <param name="in" value="PeakPickerIM_input_1.mzML" location="https://raw.githubusercontent.com/OpenMS/OpenMS/5d5cbff4053b281763a1a79bf69e81c27967cfdf/src/tests/topp/PeakPickerIM_input_1.mzML"/>
      <output name="out" value="PeakPickerIM_1_output.mzML" compare="sim_size" delta_frac="0.7" ftype="mzml" delta="4352917" location="https://raw.githubusercontent.com/OpenMS/OpenMS/5d5cbff4053b281763a1a79bf69e81c27967cfdf/src/tests/topp/PeakPickerIM_1_output.mzML"/>
      <section name="algorithm">
        <section name="pickIMTraces">
          <param name="sum_tolerance_mz" value="1.0"/>
          <param name="sum_tolerance_im" value="0.0006"/>
          <param name="gauss_ppm_tolerance" value="5.0"/>
          <param name="sgolay_frame_length" value="5"/>
          <param name="sgolay_polynomial_order" value="3"/>
        </section>
        <section name="pickIMCluster">
          <param name="ppm_tolerance_cluster" value="50.0"/>
          <param name="im_tolerance_cluster" value="0.1"/>
        </section>
        <section name="pickIMElutionProfiles">
          <param name="ppm_tolerance_elution" value="50.0"/>
        </section>
      </section>
      <param name="OPTIONAL_OUTPUTS" value="ctd_out_FLAG"/>
      <output name="ctd_out" ftype="xml">
        <assert_contents>
          <is_valid_xml/>
        </assert_contents>
