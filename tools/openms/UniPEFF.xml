<!--This is a configuration file for the integration of a tools into Galaxy (https://galaxyproject.org/). This file was automatically generated using CTDConverter.-->
<!--Proposed Tool Section: [File Converter]-->
<tool id="UniPEFF" name="UniPEFF" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="23.0">
  <description>Convert a UniProtKB XML protein database to PEFF 1.0 with rich annotations</description>
  <macros>
    <token name="@EXECUTABLE@">UniPEFF</token>
    <import>macros.xml</import>
  </macros>
  <expand macro="requirements"/>
  <expand macro="stdio"/>
  <command detect_errors="exit_code"><![CDATA[@QUOTE_FOO@
@EXT_FOO@
#import re

## Preprocessing
mkdir in &&
cp '$in' 'in/${re.sub("[^\w\-_]", "_", $in.element_identifier)}.$gxy2omsext($in.ext)' &&
mkdir out &&
#if $ptmlist:
  mkdir ptmlist &&
  cp '$ptmlist' 'ptmlist/${re.sub("[^\w\-_]", "_", $ptmlist.element_identifier)}.$gxy2omsext($ptmlist.ext)' &&
#end if
#if $psimod_obo:
  mkdir psimod_obo &&
  cp '$psimod_obo' 'psimod_obo/${re.sub("[^\w\-_]", "_", $psimod_obo.element_identifier)}.$gxy2omsext($psimod_obo.ext)' &&
#end if
#if $unimod_obo:
  mkdir unimod_obo &&
  cp '$unimod_obo' 'unimod_obo/${re.sub("[^\w\-_]", "_", $unimod_obo.element_identifier)}.$gxy2omsext($unimod_obo.ext)' &&
#end if

## Main program call

set -o pipefail &&
@EXECUTABLE@ -write_ctd ./ &&
python3 '$__tool_directory__/fill_ctd.py' '@EXECUTABLE@.ctd' '$args_json' '$hardcoded_json' &&
@EXECUTABLE@ -ini @EXECUTABLE@.ctd
-in
'in/${re.sub("[^\w\-_]", "_", $in.element_identifier)}.$gxy2omsext($in.ext)'
-out
'out/output.${gxy2omsext("txt")}'
#if $ptmlist:
  -ptmlist
  'ptmlist/${re.sub("[^\w\-_]", "_", $ptmlist.element_identifier)}.$gxy2omsext($ptmlist.ext)'
#end if
#if $psimod_obo:
  -psimod_obo
  'psimod_obo/${re.sub("[^\w\-_]", "_", $psimod_obo.element_identifier)}.$gxy2omsext($psimod_obo.ext)'
#end if
#if $unimod_obo:
  -unimod_obo
  'unimod_obo/${re.sub("[^\w\-_]", "_", $unimod_obo.element_identifier)}.$gxy2omsext($unimod_obo.ext)'
#end if

## Postprocessing
&& mv 'out/output.${gxy2omsext("txt")}' '$out'
#if "ctd_out_FLAG" in $OPTIONAL_OUTPUTS
  && mv '@EXECUTABLE@.ctd' '$ctd_out'
#end if]]></command>
  <configfiles>
