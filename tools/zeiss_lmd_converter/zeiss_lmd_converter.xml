<tool id="ZeissLMDconverter" name="Zeiss laser-capture microdissection converter" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="22.05">
    <description>Converts tabular coordinates into a formatted text file readable by Zeiss laser-capture microdissection systems.</description>
    <macros>
        <token name="@TOOL_VERSION@">2.0.5</token>
        <token name="@VERSION_SUFFIX@">1</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">shapely</requirement>
    </requirements>
    <required_files>
        <include path="tabular_to_ZeissLMDtext.py"/>
    </required_files>
    <command detect_errors="exit_code"><![CDATA[
        python3 '$__tool_directory__/tabular_to_ZeissLMDtext.py' --input '$input' --output '$output' --input-name '$input.element_identifier'
        #for $mapping in $color_mappings
            --color-map '$mapping.match_text' '$mapping.color'
        #end for
    ]]></command>
    <inputs>
        <param name="input" type="data" format="tabular" label="Tabular file with coordinates" help="Each file must have a header and two columns, first with x and second with y coordinates. Select a dataset collection to convert each ROI separately."/>
        <repeat name="color_mappings" title="Assign ROI color by name" min="0" default="0">
            <param name="match_text" type="text" label="Text in ROI name" help="Case-insensitive match against the collection element identifier, or the dataset name for a standalone input, e.g. Tumor in Tumor-1_all.txt"/>
            <param name="color" type="select" label="ROI color">
                <option value="black">black</option>
                <option value="green">green</option>
                <option value="red">red</option>
                <option value="blue">blue</option>
            </param>
        </repeat>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="coordinates_x_y.tabular" ftype="tabular"/>
            <output name="output" file="Zeiss_converted_file.txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="coordinates_x_y_small.tabular" ftype="tabular"/>
            <output name="output" file="Zeiss_converted_file_small.txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="Tumor-1_all.tabular" ftype="tabular"/>
            <repeat name="color_mappings">
                <param name="match_text" value="Tumor"/>
                <param name="color" value="red"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Stroma"/>
                <param name="color" value="green"/>
            </repeat>
            <output name="output" file="Zeiss_converted_Tumor_red.txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="Stroma-1_all.tabular" ftype="tabular"/>
            <repeat name="color_mappings">
                <param name="match_text" value="Tumor"/>
                <param name="color" value="red"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Stroma"/>
                <param name="color" value="green"/>
            </repeat>
            <output name="output" file="Zeiss_converted_Stroma_green.txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="coordinates_x_y_small.tabular" ftype="tabular"/>
            <repeat name="color_mappings">
                <param name="match_text" value="Tumor"/>
                <param name="color" value="red"/>
            </repeat>
            <output name="output" file="Zeiss_converted_file_small.txt"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="Stroma-1_all.tabular" ftype="tabular"/>
            <repeat name="color_mappings">
                <param name="match_text" value="Tumor"/>
                <param name="color" value="red"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Lymphocytes"/>
                <param name="color" value="blue"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Necrosis"/>
                <param name="color" value="black"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Fibrosis"/>
                <param name="color" value="green"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Vessels"/>
                <param name="color" value="red"/>
            </repeat>
            <repeat name="color_mappings">
                <param name="match_text" value="Stroma"/>
                <param name="color" value="green"/>
            </repeat>
            <output name="output" file="Zeiss_converted_Stroma_green.txt"/>
        </test>
    </tests>
    <creator>
        <person givenName="Andreas" familyName="Weber-Steinhilber" identifier="https://orcid.org/0009-0009-0274-9342"/>
        <person givenName="Niko" familyName="Pinter" identifier="https://github.com/npinter"/>
    </creator>
    <help>
        This tool reads tabular data containing x and y coordinates, processes it to form a closed polygon,
        calculates the polygon's area, and writes a formatted text file readable by the PALM RoboSoftware of Zeiss laser-capture microdissection systems.

        Select a single coordinate dataset or use Galaxy's collection mapping on the same input to convert a collection.
        Collection mapping produces one Zeiss text file per ROI and preserves the collection's element identifiers.

        Optionally, add any number of text/color rules. Each rule matches text without regard to case in the collection element
        identifier, or in the dataset name for a standalone input.
        For ROI Splitter outputs, use Tumor -> red and Stroma -> green to assign different colors to the two ROI types.
        Multiple ROI categories can share the same color. Files with no matching rule are black.
        If rules with different colors both match a file, the tool reports an error.
    </help>
    <citations>
    	<citation type="doi">10.5281/zenodo.5597138</citation>       
    </citations>
</tool>
